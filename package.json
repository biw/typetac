{
  "name": "typetac",
  "version": "1.0.0",
  "description": "Tachyons in TypeScript",
  "main": "./dist/typetac.cjs",
  "module": "./dist/typetac.mjs",
  "types": "./dist/typetac.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/typetac.d.mts",
        "default": "./dist/typetac.mjs"
      },
      "require": {
        "types": "./dist/typetac.d.cts",
        "default": "./dist/typetac.cjs"
      }
    }
  },
  "repository": "https://github.com/biw/typetac",
  "bugs": {
    "url": "https://github.com/biw/typetac/issues"
  },
  "homepage": "https://github.com/biw/typetac#readme",
  "author": "Ben Williams <ben@biwills.com>",
  "license": "MIT",
  "keywords": [
    "tachyons",
    "typescript",
    "css",
    "utility-classes"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vp test",
    "build": "vp pack",
    "gen-docs": "vp exec ts-node src/genDocs.ts",
    "prepare": "vp pack"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite-plus": "0.2.8"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
    }
  }
}
